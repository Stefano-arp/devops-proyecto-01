  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "pdfkit": "^0.20.2",
    "supertest": "^7.3.0"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
