# Ignorar todo en la raíz por defecto
/*

# Entregables del profesor
!/.github/
!/Dockerfile
!/.dockerignore
!/README.md

# Código fuente y pruebas
!/index.js
!/package.json
!/package-lock.json
!/tests/

# Usados por el workflow de despliegue (scp en main.yml)
!/scripts/
!/nginx/

!/.gitignore

# Defensa extra dentro de las carpetas permitidas
.env
.env.*
*.pem
*.key
*.sqlite
node_modules/
coverage/
